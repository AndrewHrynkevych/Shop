<%- include('partials/header') %>
<div class="auth-box">
  <h1 data-testid="page-title">Відновлення пароля</h1>
  <% if (sent) { %>
    <div class="alert alert-success" role="status" data-testid="reset-sent">Якщо обліковий запис з email <strong data-testid="reset-sent-email"><%= form.email %></strong> існує, ми надіслали на нього лист із посиланням для зміни пароля. Посилання дійсне 30 хвилин.</div>
    <p class="muted">Це демо-магазин: листи не надсилаються, а потрапляють у <a href="/mailbox" data-testid="go-mailbox">демо-пошту</a>.</p>
  <% } else { %>
    <p>Вкажіть email облікового запису, і ми надішлемо посилання для зміни пароля.</p>
    <form method="post" action="/forgot-password" class="form" novalidate data-testid="forgot-form">
      <%- include('partials/field', { name: 'email', label: 'Email', type: 'email', autocomplete: 'username' }) %>
      <button type="submit" class="btn block" data-testid="forgot-submit">Надіслати посилання</button>
    </form>
  <% } %>
  <p><a href="/login" data-testid="go-login">Повернутися до входу</a></p>
</div>
<%- include('partials/footer') %>
