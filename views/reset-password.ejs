<%- include('partials/header') %>
<div class="auth-box">
  <h1 data-testid="page-title">Новий пароль</h1>
  <% if (!token) { %>
    <div class="alert alert-error" role="alert" data-testid="reset-invalid">Посилання недійсне або застаріле.</div>
    <p><a href="/forgot-password" data-testid="go-forgot">Надіслати нове посилання</a></p>
  <% } else { %>
    <form method="post" action="/reset-password/<%= token %>" class="form" novalidate data-testid="reset-form">
      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label for="f-password">Новий пароль</label>
        <div class="password-wrap">
          <input id="f-password" name="password" type="password" autocomplete="new-password" data-testid="input-password">
          <button type="button" class="link toggle-password" data-target="f-password" data-testid="toggle-password">Показати</button>
        </div>
        <% if (errors.password) { %><p class="field-error" data-testid="error-password"><%= errors.password %></p><% } %>
      </div>
      <div class="field <%= errors.confirmPassword ? 'has-error' : '' %>">
        <label for="f-confirmPassword">Підтвердіть пароль</label>
        <input id="f-confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" data-testid="input-confirmPassword">
        <% if (errors.confirmPassword) { %><p class="field-error" data-testid="error-confirmPassword"><%= errors.confirmPassword %></p><% } %>
      </div>
      <button type="submit" class="btn block" data-testid="reset-submit">Змінити пароль</button>
    </form>
  <% } %>
</div>
<%- include('partials/footer') %>
